. /lib/svc/share/smf_include.sh

if [ -z $SMF_FMRI ]; then
	echo "SMF framework variables are not initialised."
	exit $SMF_EXIT_ERR
fi

typeset -r CONF_FILE=`svcprop -c -p config/file $SMF_FMRI`
typeset -r PIDFILE=`svcprop -c -p config/pidfile $SMF_FMRI`
typeset -r NGINX=`svcprop -c -p config/exec $SMF_FMRI`

[ ! -f "$CONF_FILE" ] && exit $SMF_EXIT_ERR_CONFIG

case "$1" in
start)
        /bin/rm -f ${PIDFILE}
#if RELVER < 151061
	# Releases older than r151061 don't support SMF managed paths so we
	# need to create the temporary directory here. It's shared by every
	# installed version of nginx (which could include ones from earlier
	# releases which have been dropped), and they may be starting together.
	# We therefore can't empty the directory.
	typeset -r TMPPATH=$(TMP_PATH)
	/bin/mkdir -m 0700 $TMPPATH 2>/dev/null
	if [ -h $TMPPATH -o ! -d $TMPPATH -o ! -O $TMPPATH ]; then
		echo "$TMPPATH is not a directory owned by `id -un`"
		exit $SMF_EXIT_ERR_FATAL
	fi
	/bin/chmod 0700 $TMPPATH
#endif
	exec ${NGINX} -c ${CONF_FILE} 2>&1
        ;;
*)
        echo "Unknown method."
        exit $SMF_EXIT_ERR_FATAL
        ;;
esac

# Not reached
exit $SMF_EXIT_OK

